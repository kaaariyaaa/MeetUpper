# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Application (client) ID
DISCORD_APPLICATION_ID=
# Set only for development to register slash commands to one guild instantly.
DISCORD_GUILD_ID=
# Timezone used to parse "YYYY-MM-DD HH:mm" inputs and display is via Discord timestamps.
DEFAULT_TIMEZONE=Asia/Tokyo
# SQLite database file.
DB_PATH=data/meetupper.db
